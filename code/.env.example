# Chep file nay thanh .env roi dien thong tin that.
# File .env KHONG duoc dua len kho ma nguon chung.

# --- Nha cung cap AI ---
# claude : goi thang Claude
# openai : goi may chu bat ky noi chuan OpenAI, ke ca proxy noi bo
NHA_CUNG_CAP=claude

# De trong thi he thong chay che do gia lap, van thu duoc giao dien
# va bang thong ke ma khong ton tien.
ANTHROPIC_API_KEY=

# Chi dung khi NHA_CUNG_CAP=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Mo hinh ---
# Mac dinh claude-opus-5-5. Day la mo hinh manh nhat nhung cung dat nhat.
# Voi ung dung hoi bai hang ngay, can nhac doi sang mo hinh re hon de tiet
# kiem chi phi van hanh. Xem bang gia tai trang cua nha cung cap.
MA_MO_HINH=claude-opus-5-5

# Muc no luc suy nghi: low | medium | high | xhigh | max
# Cau hoi bai tap thong thuong dung medium la du.
MUC_NO_LUC=medium

# Gioi han do dai cau tra loi. Gia su mo cao hon thi ton tien hon.
SO_TOKEN_TOI_DA=2000

# --- Truy xuat hoc lieu ---
SO_DOAN_TRUY_XUAT=4
# So tu co nghia toi thieu phai khop thi doan moi duoc coi la lien quan.
# Do thuc te tren kho mau: nguong 3 giu duoc 8/8 cau hoi that va chan 4/4
# cau ngoai pham vi. Nguong 4 bat dau loai nham cau that.
SO_TU_KHOP_TOI_THIEU=3
DO_DAI_DOAN=900
DO_CHONG_LAN=150

# --- Nguong canh bao giam sat ky thi ---
# Day la nhung con so hoc sinh se tu tay chinh trong buoi hoc thu ba.
GIAY_ROI_KHUNG_HINH=2.0
GIAY_NHIN_RA_NGOAI=3.0
GIAY_CHUYEN_CUA_SO=1.0
NGUONG_GOC_NHIN=0.35

# --- He thong ---
CONG=8000
CHE_DO_GO_LOI=1

# --- Bao ve du lieu khi trien khai ---
# Bat khi dat sau reverse proxy HTTPS. X-Forwarded-Proto phai la https.
BAT_BUOC_HTTPS=0
# Dat tep SQLite tren o dia duoc ma hoa (BitLocker/FileVault/LUKS) cua nha truong.
DUONG_DAN_DB=data/hethong.db
